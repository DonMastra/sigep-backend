{
  "info": {
    "name": "SiGEP Backend API",
    "description": "Coleccion Postman para endpoints actuales de SiGEP (modular monolith).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "c0f8f9ad-7f8f-4af8-9e89-cd2f9d7a1122"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "studentId", "value": "1" },
    { "key": "guardianId", "value": "6" },
    { "key": "courseId", "value": "1" },
    { "key": "enrollmentId", "value": "1" },
    { "key": "sessionId", "value": "1" },
    { "key": "materialId", "value": "1" },
    { "key": "certificateId", "value": "1" },
    { "key": "teachingStaffId", "value": "1" },
    { "key": "nonTeachingStaffId", "value": "1" },
    { "key": "staffAttendanceId", "value": "1" },
    { "key": "examId", "value": "11111111-1111-1111-1111-111111111101" },
    { "key": "submissionId", "value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaa1001" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('token', json.data.token || '');",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"qa.user\",\n  \"email\": \"qa.user@sigep.edu.mx\",\n  \"password\": \"password123\",\n  \"firstName\": \"QA\",\n  \"lastName\": \"User\",\n  \"role\": \"TEACHER\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh-token"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
